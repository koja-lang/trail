alias HTTP.Method
alias HTTP.Status
alias HTTP.Version
alias JSON.Value
alias Test.require

test "path and query come from the request URI"
  conn = Conn.from_request(request(Method.Get, "/items?limit=5&q=abc"))
  assert conn.path == "/items"
  assert conn.query == "limit=5&q=abc"

  conn = Conn.from_request(request(Method.Get, "/items"))
  assert conn.path == "/items"
  assert conn.query == ""
end

test "query_param returns the first decoded value"
  conn = try require(decoded(Method.Get, "/items?q=a+b%21&q=second&limit=5"))
  assert conn.query_param("q") == Option.Some("a b!")
  assert conn.query_param("limit") == Option.Some("5")
  assert conn.query_param("absent") == Option.None
end

test "query_values returns every value in wire order"
  conn = try require(decoded(Method.Get, "/items?tag=b&other=1&tag=a"))
  assert conn.query_values("tag") == ["b", "a"]
  assert conn.query_values("other") == ["1"]
  assert conn.query_values("absent") == []
end

test "a key with no value reads as empty"
  conn = try require(decoded(Method.Get, "/items?flag&empty=&x=1"))
  assert conn.query_param("flag") == Option.Some("")
  assert conn.query_param("empty") == Option.Some("")
  assert conn.query_param("x") == Option.Some("1")
end

test "bracket keys are literal"
  conn = try require(decoded(Method.Get, "/items?tag[]=a&tag[]=b"))
  assert conn.query_values("tag[]") == ["a", "b"]
  assert conn.query_param("tag") == Option.None
end

test "json sets body and content headers"
  conn = Conn.from_request(request(Method.Get, "/data"))
  body: Value = ["ok": true]
  response = conn.json(Status.ok(), body).to_response()

  assert response.status.code == 200
  assert response.text() == Result.Ok("{\"ok\":true}")
  assert response.headers.get("Content-Type") == Option.Some("application/json")
  assert response.headers.get("Content-Length") == Option.Some("11")
end

test "text sets body and content headers"
  conn = Conn.from_request(request(Method.Get, "/"))
  response = conn.text(Status.ok(), "hi").to_response()

  assert response.status.code == 200
  assert response.text() == Result.Ok("hi")
  assert response.headers.get("Content-Type") ==
    Option.Some("text/plain; charset=utf-8")
  assert response.headers.get("Content-Length") == Option.Some("2")
end

test "a conn with no response becomes a 500 and keeps the request version"
  req = request(Method.Get, "/")
  req.version = Version.HTTP1_0
  conn = Conn.from_request(req)
  response = conn.to_response()

  assert conn.resp_status == Option.None
  assert response.status.code == 500
  assert response.version == Version.HTTP1_0
  assert response.headers.get("Content-Length") == Option.Some("0")
end

test "resp stores a String body as its UTF-8 bytes"
  conn = Conn.from_request(request(Method.Get, "/")).resp(Status.ok(), "héllo")
  response = conn.to_response()

  assert conn.resp_status == Option.Some(Status.ok())
  assert response.text() == Result.Ok("héllo")
  assert response.headers.get("Content-Length") == Option.Some("6")
  assert response.headers.get("Content-Type") == Option.None
end

test "resp keeps a Binary body that is not UTF-8"
  conn = Conn.from_request(request(Method.Get, "/"))
  response = conn.resp(Status.ok(), <<255, 0, 254>>).to_response()

  assert response.body == <<255, 0, 254>>
  assert response.headers.get("Content-Length") == Option.Some("3")
end
