alias HTTP.Method
alias HTTP.Request
alias HTTP.Response
alias HTTP.Status
alias URI.Error as URIError

@doc """
One registered route. A method, a segmented path pattern, and the
handler to run on a match.
"""
struct Route
  handler: fn (Conn) -> Conn
  method: Method
  segments: List<String>
end

impl Equality for Route
  @doc """
  Compares the method and path pattern. The handler does not take part.
  """
  fn equals?(self, other: Route) -> Bool
    self.method == other.method and self.segments == other.segments
  end
end

@doc """
An immutable route table. Build one with the chainable verb
functions, then serve requests with `dispatch`.

```
router = Router{}
  .use(&log_requests/1)
  .get("/health", &health/1)
  .get("/sessions/:id", c -> sessions.show(c))

response = router.dispatch(request)
```

Middleware registered with `use` runs in order before the matched
handler, and a halted conn stops the pipeline. Pattern segments
starting with `:` bind path parameters, read with `Conn.param`.

The router answers three requests itself, each as a `Rejection`. A
path or query that does not decode is a 400, a path with routes for
other methods only is a 405 with an `Allow` header, and no match at
all is a 404. The default renders the status reason as plain text.
`on_reject` replaces it.
"""
struct Router
  middleware: List<fn (Conn) -> Conn> = []
  reject: fn (Conn, Rejection) -> Conn = &default_reject/2
  routes: List<Route> = []

  @doc """
  Appends a middleware function. Middleware runs for every request,
  matched or not, in registration order.
  """
  fn use(self, middleware: fn (Conn) -> Conn) -> Router
    self.middleware = self.middleware.append(middleware)
    self
  end

  @doc """
  Replaces the function that renders a `Rejection`. The router has
  already set the `Allow` header on the conn for `MethodNotAllowed`.
  """
  fn on_reject(self, handler: fn (Conn, Rejection) -> Conn) -> Router
    self.reject = handler
    self
  end

  fn delete(self, pattern: String, handler: fn (Conn) -> Conn) -> Router
    self.route(Method.Delete, pattern, handler)
  end

  fn get(self, pattern: String, handler: fn (Conn) -> Conn) -> Router
    self.route(Method.Get, pattern, handler)
  end

  fn patch(self, pattern: String, handler: fn (Conn) -> Conn) -> Router
    self.route(Method.Patch, pattern, handler)
  end

  fn post(self, pattern: String, handler: fn (Conn) -> Conn) -> Router
    self.route(Method.Post, pattern, handler)
  end

  fn put(self, pattern: String, handler: fn (Conn) -> Conn) -> Router
    self.route(Method.Put, pattern, handler)
  end

  @doc """
  Registers a route for an arbitrary method.
  """
  fn route(self, method: Method, pattern: String, handler: fn (Conn) -> Conn)
    -> Router

    route = Route{
      handler: handler,
      method: method,
      segments: split_segments(pattern),
    }
    self.routes = self.routes.append(route)
    self
  end

  @doc """
  Runs a request through decoding, the middleware, and the first
  matching route, returning the response. A request the router
  rejects goes through `reject` instead of a handler. Middleware
  never sees a request that failed to decode.
  """
  fn dispatch(self, request: Request) -> Response
    reject = self.reject
    conn = Conn.from_request(request)

    conn =
      match decode(conn)
        Result.Ok(decoded) -> decoded
        Result.Err(err) ->
          return reject(conn, Rejection.BadRequest(err)).to_response()
      end

    for middleware in self.middleware
      if conn.halted
        return conn.to_response()
      end

      conn = middleware(conn)
    end

    if conn.halted
      return conn.to_response()
    end

    found: List<Method> = []

    for route in self.routes
      match bind_params(route.segments, conn.path_segments)
        Option.Some(params) ->
          if route.method == conn.method
            conn.path_params = params
            handler = route.handler
            return handler(conn).to_response()
          end

          found = found.append(route.method)

        Option.None ->
          ()
      end
    end

    if found.empty?()
      return reject(conn, Rejection.NotFound).to_response()
    end

    allowed = allow_list(found)
    conn = conn.put_resp_header(
      "Allow",
      String.join(allowed.map(m -> m.to_string()), ", "),
    )
    reject(conn, Rejection.MethodNotAllowed(allowed)).to_response()
  end
end

impl Equality for Router
  @doc """
  Compares registered route patterns. Handlers and middleware do not
  take part.
  """
  fn equals?(self, other: Router) -> Bool
    self.routes == other.routes
  end
end

# Splits a path into its segments, so "/sessions/abc" becomes
# ["sessions", "abc"]. Empty segments drop out, so trailing slashes
# are tolerated.
priv fn split_segments(path: String) -> List<String>
  segments: List<String> = List.new()

  for segment in path.split("/")
    if not segment.empty?()
      segments = segments.append(segment)
    end
  end

  segments
end

# Fills `path_segments` and `query_params` from the raw path and
# query. Each path segment decodes on its own, so an encoded slash
# stays inside its segment. Query pairs split at the first `=`, and
# `+` reads as a space before percent decoding, as in form encoding.
priv fn decode(conn: Conn) -> Conn ! URIError
  segments: List<String> = []

  for segment in split_segments(conn.path)
    segments = segments.append(try URI.decode(segment))
  end

  params: List<(String, String)> = []

  for pair in conn.query.split("&")
    if not pair.empty?()
      params = params.append(try decode_pair(pair))
    end
  end

  conn.path_segments = segments
  conn.query_params = params
  conn
end

priv fn decode_pair(pair: String) -> (String, String) ! URIError
  parts = pair.split("=")
  key = parts.get(0).or("")
  value = String.join(parts.slice(1, parts.length() - 1), "=")
  (try decode_form(key), try decode_form(value))
end

priv fn decode_form(text: String) -> String ! URIError
  try URI.decode(text.replace("+", " "))
end

# Every method a route table can hold, in `Allow` header order.
priv fn all_methods -> List<Method>
  [
    Method.Connect,
    Method.Delete,
    Method.Get,
    Method.Head,
    Method.Options,
    Method.Patch,
    Method.Post,
    Method.Put,
    Method.Query,
    Method.Trace
  ]
end

# Sorts and deduplicates the methods that matched a path.
priv fn allow_list(found: List<Method>) -> List<Method>
  all_methods().filter(method -> found.any?(m -> m == method))
end

# Matches path segments against pattern segments, binding `:name`
# parameters. Returns the bindings, or None when the shapes differ.
priv fn bind_params(pattern: List<String>, path: List<String>)
  -> Option<List<(String, String)>>

  if pattern.length() != path.length()
    return Option.None
  end

  params: List<(String, String)> = List.new()

  for index in Range{start: 0, stop: pattern.length() - 1}
    expected = pattern.get(index).or("")
    actual = path.get(index).or("")

    if expected.starts_with?(":")
      name = expected.slice(Range{start: 1, stop: expected.length() - 1})
      params = params.append((name, actual))
    else
      if expected != actual
        return Option.None
      end
    end
  end

  Option.Some(params)
end

# Public only because the `reject` field default names it.
@doc false
fn default_reject(conn: Conn, rejection: Rejection) -> Conn
  status = rejection.status()
  conn.text(status, status.reason())
end
